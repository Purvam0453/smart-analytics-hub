# ============================================================
# Smart Analytics Hub - Environment Variables
# ============================================================
# Copy this file to .env for local development ONLY.
# Never commit .env. Set these as environment variables on your host.
# ============================================================

# ------------------------------------------------------------
# Backend (Render / FastAPI)
# ------------------------------------------------------------

# Secret used to sign JWT auth tokens. Use a long random string in production.
# If not set, the backend generates a random key on every start
# (which logs users out when the server restarts). Set it explicitly.
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Comma-separated list of allowed CORS origins for the deployed frontend.
# e.g. https://smart-analytics-hub.vercel.app
FRONTEND_URL=https://smart-analytics-hub.vercel.app

# Database connection string.
# Default is a local SQLite file (backend/app.db).
# NOTE: Render free web services use an ephemeral filesystem, so SQLite data
# is reset every time the service restarts or redeploys. For a demo this is fine.
# If you later want persistent data, set this to a hosted PostgreSQL URL.
DATABASE_URL=sqlite:///app.db

# ------------------------------------------------------------
# Frontend (Vercel / Vite) - set these in the Vercel dashboard
# ------------------------------------------------------------
# Backend API base URL used by the frontend at build/run time.
# VITE_API_URL=https://smart-analytics-hub-backend.onrender.com
